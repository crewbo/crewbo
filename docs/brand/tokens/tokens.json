{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Crewbo design tokens v0.1. Format: W3C Design Tokens (DTCG). Source of truth for colour, type, space, radius, border and motion. Spec: docs/brand/03-color.md, 04-typography.md, 05-interface.md, 07-bo-motion.md.",
  "color": {
    "ink":   { "$type": "color", "$value": "#0A0A0A", "$description": "Primary text, the logo, primary buttons." },
    "paper": { "$type": "color", "$value": "#FFFFFF", "$description": "Page background on light; Bo's eyes." },
    "gray": {
      "800": { "$type": "color", "$value": "#262626", "$description": "Body copy on light (secondary emphasis); flask and keyboard fill." },
      "700": { "$type": "color", "$value": "#404040", "$description": "Keys, desk line, dark-mode inactive controls." },
      "600": { "$type": "color", "$value": "#525252", "$description": "Secondary text on light (7.81:1 on paper). Offline Bo body on dark." },
      "500": { "$type": "color", "$value": "#737373", "$description": "Offline Bo body on light. Not for text on dark (below 4.5:1); use gray.450. BDR-016." },
      "450": { "$type": "color", "$value": "#858585", "$description": "Tertiary text on dark: 4.86:1 on #171717, 5.19:1 on #0F0F0F, 4.99:1 on #141414. BDR-016." },
      "400": { "$type": "color", "$value": "#A3A3A3", "$description": "Secondary text on dark (7.3:1 on #141414). Z's, flask outline." },
      "200": { "$type": "color", "$value": "#E5E5E5", "$description": "Borders on light. Lit key." },
      "100": { "$type": "color", "$value": "#F5F5F5", "$description": "Card and section fill on light. Book pages." }
    },
    "surface": {
      "dark": {
        "chrome": { "$type": "color", "$value": "#0A0A0A", "$description": "Title bar, status bar." },
        "editor": { "$type": "color", "$value": "#141414", "$description": "Editor background in mockups." },
        "panel":  { "$type": "color", "$value": "#0F0F0F", "$description": "Explorer and crew panel background." },
        "row":    { "$type": "color", "$value": "#171717", "$description": "Crew panel row." },
        "rowActive": { "$type": "color", "$value": "#1A1A1A", "$description": "Selected explorer row; also the badge ring colour." },
        "line":   { "$type": "color", "$value": "#262626", "$description": "1 px dividers on dark." }
      }
    },
    "signal": {
      "claimed":  { "$type": "color", "$value": "#15803D", "$description": "A file is claimed. Always paired with the word 'claimed' or an icon." },
      "synced":   { "$type": "color", "$value": "#1D4ED8", "$description": "Synced / informational." },
      "handoff":  { "$type": "color", "$value": "#F59E0B", "$description": "Handoff requested / warning. Use ink text on it (9.22:1), never white." },
      "conflict": { "$type": "color", "$value": "#DC2626", "$description": "Conflict / blocked." }
    },
    "team": {
      "$description": "Teammate colours, assigned in this order on join. base = Bo body (white eyes >= 4.92:1). tint = text/outline on dark themes (>= 9.2:1 on #141414). highlight = editor line wash.",
      "cobalt": { "base": { "$type": "color", "$value": "#1D4ED8" }, "tint": { "$type": "color", "$value": "#93C5FD" }, "highlight": { "$type": "color", "$value": "rgba(29,78,216,0.16)" } },
      "teal":   { "base": { "$type": "color", "$value": "#0F766E" }, "tint": { "$type": "color", "$value": "#5EEAD4" }, "highlight": { "$type": "color", "$value": "rgba(15,118,110,0.18)" } },
      "moss":   { "base": { "$type": "color", "$value": "#15803D" }, "tint": { "$type": "color", "$value": "#86EFAC" }, "highlight": { "$type": "color", "$value": "rgba(21,128,61,0.18)" } },
      "ember":  { "base": { "$type": "color", "$value": "#C2410C" }, "tint": { "$type": "color", "$value": "#FDBA74" }, "highlight": { "$type": "color", "$value": "rgba(194,65,12,0.16)" } },
      "ochre":  { "base": { "$type": "color", "$value": "#A16207" }, "tint": { "$type": "color", "$value": "#FDE047" }, "highlight": { "$type": "color", "$value": "rgba(161,98,7,0.18)" } },
      "rose":   { "base": { "$type": "color", "$value": "#BE185D" }, "tint": { "$type": "color", "$value": "#F9A8D4" }, "highlight": { "$type": "color", "$value": "rgba(190,24,93,0.16)" } },
      "violet": { "base": { "$type": "color", "$value": "#7E22CE" }, "tint": { "$type": "color", "$value": "#D8B4FE" }, "highlight": { "$type": "color", "$value": "rgba(126,34,206,0.16)" } },
      "indigo": { "base": { "$type": "color", "$value": "#4338CA" }, "tint": { "$type": "color", "$value": "#A5B4FC" }, "highlight": { "$type": "color", "$value": "rgba(67,56,202,0.16)" } }
    },
    "prop": {
      "$description": "Colours used only inside Bo scenes.",
      "liquid":      { "$type": "color", "$value": "#2DD4BF", "$description": "Flask liquid while tests run." },
      "liquidPass":  { "$type": "color", "$value": "#4ADE80", "$description": "Flask liquid when tests pass." },
      "bubble":      { "$type": "color", "$value": "#CCFBF1" },
      "pageShade":   { "$type": "color", "$value": "#C7C7C7", "$description": "Page mid-turn." }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Instrument Sans", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700, "$description": "Only for Bo's z glyphs." }
    }
  },
  "type": {
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "64px", "lineHeight": 1.0, "letterSpacing": "-2px" } },
    "h1":      { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "56px", "lineHeight": 1.05, "letterSpacing": "-1.6px" } },
    "h2":      { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "44px", "lineHeight": 1.1, "letterSpacing": "-1.2px" } },
    "h3":      { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "22px", "lineHeight": 1.3, "letterSpacing": "0px" } },
    "title":   { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "20px", "lineHeight": 1.3, "letterSpacing": "0px" } },
    "bodyLg":  { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "18px", "lineHeight": 1.55, "letterSpacing": "0px" } },
    "body":    { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "15px", "lineHeight": 1.5, "letterSpacing": "0px" } },
    "small":   { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "13px", "lineHeight": 1.4, "letterSpacing": "0px" } },
    "label":   { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 400, "fontSize": "13px", "lineHeight": 1.4, "letterSpacing": "0px" }, "$description": "Section eyebrows ('01 · THE MARK'), hex codes, model names. Upper case for eyebrows." },
    "code":    { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 400, "fontSize": "15px", "lineHeight": "30px", "letterSpacing": "0px" } },
    "wordmark":{ "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "52px", "lineHeight": 1.0, "letterSpacing": "-1.6px" }, "$description": "Use the outlined SVG lockup instead of live text wherever possible." }
  },
  "space": {
    "$description": "8 px grid. 4 is allowed only inside dense components (pills, tags).",
    "0": { "$type": "dimension", "$value": "0px" },
    "half": { "$type": "dimension", "$value": "4px" },
    "1": { "$type": "dimension", "$value": "8px" },
    "2": { "$type": "dimension", "$value": "16px" },
    "3": { "$type": "dimension", "$value": "24px" },
    "4": { "$type": "dimension", "$value": "32px" },
    "5": { "$type": "dimension", "$value": "40px" },
    "6": { "$type": "dimension", "$value": "48px" },
    "7": { "$type": "dimension", "$value": "56px" },
    "9": { "$type": "dimension", "$value": "72px" },
    "12": { "$type": "dimension", "$value": "96px" },
    "16": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "12px", "$description": "Buttons, inputs." },
    "controlSm": { "$type": "dimension", "$value": "10px", "$description": "Compact buttons inside toasts." },
    "row": { "$type": "dimension", "$value": "14px", "$description": "Crew panel rows, swatches." },
    "card": { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "appIcon": { "$type": "dimension", "$value": "22.857%", "$description": "32 px on a 140 px tile." }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "2px", "$description": "Light UI. Dark editor surfaces use 1px #262626 hairlines." },
    "widthHairline": { "$type": "dimension", "$value": "1px" }
  },
  "motion": {
    "duration": {
      "transition": { "$type": "duration", "$value": "200ms", "$description": "State crossfade." },
      "eventMax":   { "$type": "duration", "$value": "300ms", "$description": "Upper bound for any UI reaction." },
      "blink":      { "$type": "duration", "$value": "4200ms" },
      "idleGlance": { "$type": "duration", "$value": "10000ms" },
      "read":       { "$type": "duration", "$value": "2400ms" },
      "bob":        { "$type": "duration", "$value": "1600ms" },
      "shake":      { "$type": "duration", "$value": "540ms" },
      "breathe":    { "$type": "duration", "$value": "3600ms" },
      "z":          { "$type": "duration", "$value": "2400ms" },
      "key":        { "$type": "duration", "$value": "1400ms" },
      "flask":      { "$type": "duration", "$value": "4000ms" },
      "bubble":     { "$type": "duration", "$value": "2000ms" },
      "bookEyes":   { "$type": "duration", "$value": "5000ms" },
      "page":       { "$type": "duration", "$value": "6000ms" },
      "caretNewline": { "$type": "duration", "$value": "120ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.42, 0, 0.58, 1], "$description": "CSS ease-in-out. Default for Bo loops." },
      "out":      { "$type": "cubicBezier", "$value": [0, 0, 0.58, 1], "$description": "CSS ease-out. Entrances, puffs, z's." },
      "in":       { "$type": "cubicBezier", "$value": [0.42, 0, 1, 1], "$description": "CSS ease-in. Rising bubbles." }
    }
  },
  "size": {
    "bo": {
      "dotMax":   { "$type": "dimension", "$value": "15px", "$description": "At or below this, never draw Bo: draw an 8px colour dot." },
      "badge":    { "$type": "dimension", "$value": "16px", "$description": "Explorer file badge. Static." },
      "caret":    { "$type": "dimension", "$value": "18px", "$description": "Rides the caret." },
      "avatarSm": { "$type": "dimension", "$value": "32px", "$description": "Toasts, notifications." },
      "scene":    { "$type": "dimension", "$value": "64px", "$description": "Crew panel row." },
      "sceneLg":  { "$type": "dimension", "$value": "150px", "$description": "Marketing / docs." }
    },
    "logo": {
      "markMin":   { "$type": "dimension", "$value": "16px" },
      "lockupMin": { "$type": "dimension", "$value": "80px", "$description": "Minimum lockup width." }
    }
  }
}
